{
    "name": "React Insight AI",
    "description": "A Chrome DevTools extension that hooks into a webpage's React Fiber tree and visualizes it",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "hashira.png"
    },
    "background": {
        "service_worker": "dist/background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "dist/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "dist/injected.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}